# Frontend config (read at build time by Vite). Copy to .env or .env.local, or set these in Vercel.
# The backend has its own config in server/.env.example.

# Backend base URL, without /api. Empty = the in-browser mock.
# Local backend: http://localhost:8787   Phones and Vercel: your ngrok https URL.
VITE_API_BASE=http://localhost:8787

# true forces the in-browser mock even when VITE_API_BASE is set.
VITE_USE_MOCK=false

# Public URL of this UI (your Vercel URL). The runner QR on /live points at <VITE_PUBLIC_URL>/runner.
# Empty = the page's own origin, which phones can't open when the projector runs on localhost.
VITE_PUBLIC_URL=

# Shown next to the checkout link while the Shopify dev store is password-protected. Empty = hidden.
VITE_SHOP_PASSWORD=
