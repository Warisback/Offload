# offload backend config. Copy to server/.env and fill in. Never commit .env.
# Every service is optional: a missing key means that step falls back and the demo still runs.

# Port the API listens on (expose it to phones with: ngrok http 8787)
PORT=8787
# Public URL of the UI, used in the "Make an offer" link on every Shopify listing
UI_BASE=https://your-ui.vercel.app

# OpenAI: live filming prompts, voice transcription, and (when there's no Anthropic key)
# the pile estimate, photo grading, comps filter and listing descriptions
OPENAI_API_KEY=
# Optional: live-prompt model (blank = fastest small vision model on the key, gpt-5.4-nano first)
OPENAI_MODEL=
# Optional: model for estimate/grading/descriptions when running on OpenAI
OPENAI_BRAIN_MODEL=gpt-5.4-mini

# Anthropic (optional): if set, Claude Sonnet runs the estimate, grading and descriptions instead of OpenAI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini (optional): backup for live filming prompts if OpenAI errors
GEMINI_API_KEY=
# Optional Gemini model id; blank = the fastest Flash model the key can see
GEMINI_MODEL=

# Tavily: price comparisons from public eBay UK, Depop, Vestiaire and ASOS Marketplace results
TAVILY_API_KEY=

# Shopify development store: "my-shop", "my-shop.myshopify.com" or the full https URL all work
SHOPIFY_STORE=
# Either a static Admin API token...
SHOPIFY_ADMIN_TOKEN=
# ...or a Dev Dashboard app's client id + secret (the backend mints 24 h tokens itself).
# Scopes: write_products, read_products, write_discounts, read_orders, write_draft_orders,
#         read_publications, write_publications
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Supabase project URL and service role key (server-side only, bypasses RLS, never put it in the UI)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional Storage bucket name for photos (schema.sql creates "photos")
# SUPABASE_BUCKET=photos

# 1 = wipe state back to mock/seed.json on every boot, 0 = keep what's in Supabase
RESET_ON_BOOT=0

# Optional timeouts in ms (defaults in src/config.js):
# LIVE_TIMEOUT_MS=2500
# ESTIMATE_TIMEOUT_MS=22000
# PHOTOS_TIMEOUT_MS=20000
# TEXT_TIMEOUT_MS=12000
# COMPS_TIMEOUT_MS=10000
# TAVILY_TIMEOUT_MS=7000
# SHOPIFY_TIMEOUT_MS=10000
# STORAGE_TIMEOUT_MS=10000
